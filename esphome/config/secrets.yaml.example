# Cópialo a secrets.yaml y rellénalo.  NO lo compartas ni lo subas a ningún
# sitio: lleva la contraseña de tu WiFi.
#
#   cp secrets.yaml.example secrets.yaml

wifi_ssid: "NOMBRE_DE_TU_WIFI"
wifi_password: "CONTRASEÑA_DE_TU_WIFI"

# Clave de cifrado entre el dispositivo y Home Assistant.
# Genera una con:  openssl rand -base64 32
api_key: "PEGA_AQUI_LA_CLAVE_GENERADA"

# Contraseña para actualizar el firmware por WiFi. Invéntate una.
ota_password: "otra_contraseña_cualquiera"

# Credenciales del broker MQTT (las que creaste con mosquitto_passwd),
# por si algún ESP32 las necesita.
mqtt_user: "casa"
mqtt_password: "LA_MISMA_QUE_PUSISTE_EN_MOSQUITTO"
