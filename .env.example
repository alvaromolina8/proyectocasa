# Copia este archivo a .env y ajústalo:   cp .env.example .env

TZ=Europe/Madrid

# Dónde se guardan las grabaciones de las cámaras.
# Si tienes un disco aparte en el PC viejo, apunta aquí a él.
# Calcula ~1 GB por cámara y día grabando solo eventos.
FRIGATE_MEDIA=./frigate/media

# Modelo de reconocimiento de voz.
#   tiny-int8  → rapidísimo, se equivoca bastante
#   base-int8  → buen equilibrio, ~1,5 GB RAM   ← recomendado para 8 GB
#   small-int8 → mejor precisión, ~2,5 GB RAM y lento en CPU viejas
WHISPER_MODEL=base-int8

# Voz en castellano. Otras opciones: es_ES-sharvard-medium (mujer),
# es_MX-ald-medium (México). Se descarga sola la primera vez.
PIPER_VOICE=es_ES-davefx-medium
